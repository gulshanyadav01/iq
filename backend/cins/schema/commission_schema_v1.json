{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://policybazaar.com/schemas/commission_schema_v1.json",
  "title": "Commission Intelligence Canonical Schema (CICS)",
  "description": "Standardized schema for normalizing heterogeneous insurance commission data into a machine-readable, auditable format",
  "type": "object",
  "required": [
    "schema_version",
    "document_metadata",
    "provider",
    "commission_period",
    "products"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the CICS schema being used"
    },
    "document_metadata": {
      "type": "object",
      "required": ["document_id", "extracted_at", "extractor"],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique identifier for this normalized document"
        },
        "source_type": {
          "type": "string",
          "enum": ["email", "pdf", "excel", "api", "manual"],
          "description": "Type of source document"
        },
        "source_file": {
          "type": "string",
          "description": "Original filename or identifier"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of extraction"
        },
        "extractor": {
          "type": "string",
          "description": "Identifier of extraction system or person (e.g., 'gpt-4', 'manual-user123')"
        },
        "notes": {
          "type": "string",
          "description": "Additional context or extraction notes"
        }
      }
    },
    "provider": {
      "type": "object",
      "required": ["provider_id", "provider_name"],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique identifier for the insurance provider"
        },
        "provider_name": {
          "type": "string",
          "description": "Full name of the insurance provider"
        },
        "contact_email": {
          "type": "string",
          "format": "email",
          "description": "Primary contact email for commission queries"
        },
        "contact_phone": {
          "type": "string",
          "description": "Primary contact phone number"
        }
      }
    },
    "commission_period": {
      "type": "object",
      "required": ["effective_from"],
      "properties": {
        "effective_from": {
          "type": "string",
          "format": "date",
          "description": "Start date of commission period (YYYY-MM-DD)"
        },
        "effective_to": {
          "type": "string",
          "format": "date",
          "description": "End date of commission period (YYYY-MM-DD), null if ongoing"
        },
        "period_label": {
          "type": "string",
          "description": "Human-readable period label (e.g., 'Q1 2024', 'Jan 2024')"
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Product"
      },
      "description": "List of insurance products with their commission rules"
    },
    "change_reference": {
      "type": "object",
      "properties": {
        "previous_document_id": {
          "type": "string",
          "description": "Document ID of previous period's commission structure"
        },
        "previous_period": {
          "type": "string",
          "format": "date",
          "description": "Effective date of previous period"
        },
        "is_inherited": {
          "type": "boolean",
          "description": "True if this document inherits from previous period (e.g., 'same as last month')"
        },
        "inheritance_notes": {
          "type": "string",
          "description": "Details about inheritance or changes from previous period"
        }
      },
      "description": "Reference to previous period for tracking changes and inheritance"
    },
    "source_traces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceTrace"
      },
      "description": "Array of source traceability records linking extracted data to original source"
    },
    "validation": {
      "type": "object",
      "properties": {
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall confidence score for the entire extraction (0-1)"
        },
        "requires_manual_review": {
          "type": "boolean",
          "description": "Flag indicating if manual review is recommended"
        },
        "validation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of validation warnings or issues"
        }
      },
      "description": "Validation and confidence tracking"
    }
  },
  "$defs": {
    "Product": {
      "type": "object",
      "required": ["product_code", "product_name", "commission_rules"],
      "properties": {
        "product_code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique code for this product (e.g., 'MOTOR_COMPREHENSIVE', 'HEALTH_INDIVIDUAL')"
        },
        "product_name": {
          "type": "string",
          "description": "Human-readable product name"
        },
        "product_category": {
          "type": "string",
          "enum": ["motor", "health", "life", "travel", "home", "other"],
          "description": "High-level product category"
        },
        "sub_category": {
          "type": "string",
          "description": "Sub-category or product type (e.g., 'two-wheeler', 'four-wheeler', 'individual-health')"
        },
        "commission_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CommissionRule"
          },
          "description": "Ordered list of commission rules (evaluated by priority)"
        },
        "deal_type": {
          "type": "string",
          "enum": ["market-deal", "market-bonus-deal", "special-deal", "special-bonus-deal", "declined-deal", "basic-deal"],
          "description": "Deal type"
        },
        "deal_business_type": {
          "type": "string",
          "enum": ["net", "ape", "tp", "od"],
          "description": "Deal business type"
        },
        "portfolio_business": {
          "type": "string",
          "enum": ["market-deal", "special-deal", "declined-deal", "partner-specific-special-deal", "registration-deal"],
          "description": "Portfolio business"
        },
        "approval_type": {
          "type": "string",
          "enum": ["deal", "booking", "manual-override"],
          "description": "Approval type"
        },
        "file_type": {
          "type": "string",
          "enum": ["irda-statement", "rewards-statement", "enhancement-statement", "orc-statement"],
          "description": "File type"
        },
        "zone": {
          "type": "string",
          "enum": ["north", "south", "east", "west"],
          "description": "Zone"
        },
        "product_mode": {
          "type": "string",
          "enum": ["online", "offline"],
          "description": "Product mode"
        },
        "bu_parameters": {
          "type": "string",
          "enum": ["motor"],
          "description": "BU parameters"
        },
        "decline_deal": {
          "type": "string",
          "enum": ["decline"],
          "description": "Decline deal"
        },
        "product_subproduct": {
          "type": "string",
          "enum": ["car", "two-wheeler", "commercial-gcv", "commercial-pcv", "commercial-buses", "commercial-miscd"],
          "description": "Product-subproduct"
        },
        "vehicle_type": {
          "type": "string",
          "enum": ["car-taxi", "two-wheeler", "gcv", "pcv", "buses", "misc-d"],
          "description": "Vehicle type"
        }
      }
    },
    "CommissionRule": {
      "type": "object",
      "required": ["rule_id", "priority", "outcome"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique identifier for this rule within the product"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "description": "Rule evaluation priority (1 = highest priority)"
        },
        "conditions": {
          "$ref": "#/$defs/RuleConditions",
          "description": "Conditions that must be met for this rule to apply"
        },
        "outcome": {
          "$ref": "#/$defs/CommissionOutcome",
          "description": "Commission outcome when conditions are met"
        },
        "valid_from": {
          "type": "string",
          "format": "date",
          "description": "Optional start date for rule validity (within commission period)"
        },
        "valid_to": {
          "type": "string",
          "format": "date",
          "description": "Optional end date for rule validity (within commission period)"
        },
        "rule_description": {
          "type": "string",
          "description": "Human-readable description of this rule"
        }
      }
    },
    "RuleConditions": {
      "type": "object",
      "description": "Domain-specific conditions for insurance commission rule matching (all conditions ANDed)",
      "properties": {
        "vehicle_sub_class": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["private-car", "taxi", "scooter", "moped", "bike", "e-rickshaw", "auto-rickshaw", "pick-up-delivery-van", "truck", "tractor", "tipper", "heavy-truck-semi-trailer", "dumper", "tanker", "trailer", "refrigerated-van", "bulker", "school-bus", "passenger-bus", "agricultural-tractor", "backhoe-loader", "crane", "ambulance", "loader", "tractor-loader", "harvester", "excavators", "garbage-van", "motor-grader", "transit-mixer", "fork-lift-trucks", "generator-van", "drilling-rigs", "compressors", "other-carts", "plane-loaders-and-other", "road-rollers", "road-sweeper", "staff-bus", "car-carrier", "greater-than-six-seater", "big-taxi", "kaali-peeli-taxi", "not-available", "e-bike", "flat-bed-trailer", "kisan-suvidha", "container", "towing-van", "bulldozer", "compactor", "gas-tanker", "jetting-machine", "fire-vehicles", "maxicab", "others"]
          },
          "description": "Vehicle sub-class(es)"
        },
        "policy_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["third-party", "comprehensive", "saod"]
          },
          "description": "Policy type(s)"
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["andaman-and-nicobar", "andhra-pradesh", "arunachal-pradesh", "assam", "bihar", "chandigarh", "chattisgarh", "delhi-ncr", "goa", "gujarat", "haryana", "jammu-and-kashmir", "himachal-pradesh", "karnataka", "jharkhand", "kerala", "lakshadweep", "madhya-pradesh", "mizoram", "maharashtra", "meghalaya", "manipur", "nagaland", "orissa", "pondicherry", "rajasthan", "punjab", "sikkim", "tamil-nadu", "telangana", "tripura", "west-bengal", "uttar-pradesh", "ladakh", "uttarakhand"]
          },
          "description": "Indian state(s) where rule applies"
        },
        "rto": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "RTO code(s)"
        },
        "number_of_wheels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["3w", "4w-and-above"]
          },
          "description": "Number of wheels"
        },
        "gvw_start_range": {
          "type": "integer",
          "description": "Start of Gross Vehicle Weight range"
        },
        "gvw_end_range": {
          "type": "integer",
          "description": "End of Gross Vehicle Weight range"
        },
        "cc_start_range": {
          "type": "integer",
          "description": "Start of engine CC range"
        },
        "cc_end_range": {
          "type": "integer",
          "description": "End of engine CC range"
        },
        "seating_capacity_start_range": {
          "type": "integer",
          "description": "Start of seating capacity range"
        },
        "seating_capacity_end_range": {
          "type": "integer",
          "description": "End of seating capacity range"
        },
        "policies_count_start_range": {
          "type": "integer",
          "description": "Start of policies-count range (number of policies sold tier, e.g. 'UPTO 30 NOP', '30-100 NOP', '100-500 NOP')"
        },
        "policies_count_end_range": {
          "type": "integer",
          "description": "End of policies-count range"
        },
        "school_bus_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["on-individual-name", "on-school-name", "on-company-name", "on-contract-transporter"]
          },
          "description": "School bus type(s)"
        },
        "booking_mode": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["online", "offline"]
          },
          "description": "Booking mode(s)"
        },
        "zero_dep": {
          "type": "string",
          "enum": ["yes", "no"],
          "description": "Zero depreciation flag"
        },
        "ncb": {
          "type": "boolean",
          "description": "No Claim Bonus tier flag: true = the policy earned a bonus, false = it earned none, null = no NCB dimension. Derived from the band at parse time, then set explicitly by the base-twin split — the no-bonus row is (0, 0) false and its mirror is (0, base_end) TRUE, so the two cannot be told apart from the range alone. Authoritative; do not re-derive it."
        },
        "ncb_start_range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Start of the No Claim Bonus percentage band, inclusive (0-100). 'NCB GT OR Equal to 25%' -> 25; its paired base grid -> 0, for both the no-bonus row and its bonus-bearing mirror. Null = no NCB dimension on this rule."
        },
        "ncb_end_range": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "End of the No Claim Bonus percentage band, inclusive (0-100). 'NCB GT OR Equal to 25%' -> 100; its paired base grid splits into the no-bonus row -> 0 and its ncb=true mirror -> 24."
        },
        "cpa": {
          "type": "string",
          "enum": ["with-cpa", "without-cpa"],
          "description": "CPA type"
        },
        "fuel_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["petrol", "diesel", "cng", "lpg", "electric"]
          },
          "description": "Fuel type(s)"
        },
        "vehicle_age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35,
          "description": "Vehicle age in years"
        },
        "vehicle_make": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vehicle make(s), free-text"
        },
        "vehicle_model": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vehicle model(s), free-text"
        },
        "vehicle_make_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vehicle make(s) to EXCLUDE — rule matches only when policy make is NOT in this list (e.g. 'All Other Make/Models' bucket)"
        },
        "vehicle_model_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Vehicle model(s) to EXCLUDE — rule matches only when policy model is NOT in this list"
        },
        "vehicle_carrier": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "private", "commercial"]
          },
          "description": "Vehicle carrier type(s)"
        },
        "business_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["new", "renewal", "rollover", "port"]
          },
          "description": "Business type(s)"
        },
        "od_term": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "OD term in years"
        },
        "tp_term": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "TP term in years"
        },
        "deal_parameter": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["od", "net", "regular-tp", "tp-with-vehicle-age", "flat-amount", "ape"]
          },
          "description": "Deal parameter(s)"
        }
      }
    },
    "NumericRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "description": "Minimum value (inclusive)"
        },
        "max": {
          "type": "number",
          "description": "Maximum value (inclusive)"
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement (e.g., 'INR', 'months', 'years', 'percent')"
        }
      }
    },
    "CommissionOutcome": {
      "type": "object",
      "required": ["commission_type"],
      "properties": {
        "commission_type": {
          "type": "string",
          "enum": ["percentage", "flat", "tiered", "hybrid"],
          "description": "Type of commission calculation"
        },
        "percentage_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Commission percentage (for percentage type)"
        },
        "flat_value": {
          "type": "number",
          "minimum": 0,
          "description": "Flat commission amount (for flat type)"
        },
        "flat_currency": {
          "type": "string",
          "default": "INR",
          "description": "Currency for flat commission"
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommissionTier"
          },
          "description": "Tiered commission structure (for tiered/hybrid types)"
        },
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bonus"
          },
          "description": "Additional bonuses applicable"
        },
        "deductions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Deduction"
          },
          "description": "Deductions applicable"
        },
        "gst_applicable": {
          "type": "boolean",
          "description": "Whether GST applies to this commission"
        },
        "gst_percentage": {
          "type": "number",
          "minimum": 0,
          "description": "GST percentage if applicable"
        },
        "calculation_notes": {
          "type": "string",
          "description": "Additional calculation instructions or notes"
        },
        "applied_on": {
          "type": "string",
          "description": "What the commission is applied on (e.g., 'OD Premium', 'Total Premium', 'GWP')"
        },
        "other_conditions": {
          "type": "string",
          "description": "Free-text qualifying conditions or footnotes from the source — verbatim, for human review"
        },
        "qualifying_clauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualifyingClause"
          },
          "description": "Structured machine-ingestable representation of footnote/notes clauses that modify this outcome"
        }
      }
    },
    "QualifyingClause": {
      "type": "object",
      "required": ["clause_type", "text"],
      "properties": {
        "clause_type": {
          "type": "string",
          "description": "Clause shape: 'applied_on_override', 'conditional_deduction', 'grid_alias', 'mandatory_requirement', 'minimum_payout', 'other'"
        },
        "text": {
          "type": "string",
          "description": "Verbatim (or near-verbatim) source clause text, ≤ 200 chars"
        },
        "when": {
          "type": "object",
          "description": "Conditions under which the clause applies"
        },
        "effect": {
          "type": "object",
          "description": "What the clause changes"
        }
      }
    },
    "CommissionTier": {
      "type": "object",
      "required": ["threshold", "value"],
      "properties": {
        "threshold": {
          "$ref": "#/$defs/NumericRange",
          "description": "Threshold range for this tier"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Commission value for this tier (percentage or flat)"
        },
        "value_type": {
          "type": "string",
          "enum": ["percentage", "flat"],
          "description": "Type of value (percentage or flat amount)"
        }
      }
    },
    "Bonus": {
      "type": "object",
      "required": ["bonus_type", "value"],
      "properties": {
        "bonus_type": {
          "type": "string",
          "description": "Type of bonus (e.g., 'volume-bonus', 'target-achievement', 'early-payment')"
        },
        "value": {
          "type": "number",
          "description": "Bonus value (percentage or flat)"
        },
        "value_type": {
          "type": "string",
          "enum": ["percentage", "flat"],
          "description": "Type of value"
        },
        "conditions": {
          "type": "string",
          "description": "Conditions for bonus eligibility"
        }
      }
    },
    "Deduction": {
      "type": "object",
      "required": ["deduction_type", "value"],
      "properties": {
        "deduction_type": {
          "type": "string",
          "description": "Type of deduction (e.g., 'processing-fee', 'cancellation-penalty')"
        },
        "value": {
          "type": "number",
          "description": "Deduction value (percentage or flat)"
        },
        "value_type": {
          "type": "string",
          "enum": ["percentage", "flat"],
          "description": "Type of value"
        },
        "conditions": {
          "type": "string",
          "description": "Conditions for deduction application"
        }
      }
    },
    "SourceTrace": {
      "type": "object",
      "required": ["trace_id", "entity_type", "entity_id"],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique identifier for this trace"
        },
        "entity_type": {
          "type": "string",
          "enum": ["product", "rule", "condition", "outcome", "provider", "period"],
          "description": "Type of entity being traced"
        },
        "entity_id": {
          "type": "string",
          "description": "ID of the entity being traced (e.g., product_code, rule_id)"
        },
        "source_location": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": "Page number in PDF"
            },
            "section": {
              "type": "string",
              "description": "Section or heading in document"
            },
            "table": {
              "type": "string",
              "description": "Table name or identifier"
            },
            "row": {
              "type": "integer",
              "description": "Row number in table/spreadsheet"
            },
            "column": {
              "type": "string",
              "description": "Column identifier in table/spreadsheet"
            }
          },
          "description": "Location in source document"
        },
        "quoted_text": {
          "type": "string",
          "description": "Exact text excerpt from source document"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score for this specific extraction (0-1)"
        },
        "extraction_notes": {
          "type": "string",
          "description": "Notes about ambiguities or interpretation decisions"
        }
      }
    }
  }
}
