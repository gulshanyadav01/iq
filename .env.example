# ── Host port mappings ────────────────────────────────────────────────
# Override per workspace to avoid collisions when running multiple
# Conductor workspaces concurrently. Convention: pick a unique 2-digit
# prefix per workspace (e.g. 20xxx, 21xxx, 22xxx) and update every
# *_PORT / *_HOST_PORT below plus the browser-facing URL env vars to
# match. Container ports never change — only host-side bindings vary.
PROXY_PORT=8080
API_PORT=20000
APP_PORT=20001
AUTH_HOST_PORT=20010
POSTGRES_HOST_PORT=20020
REDIS_HOST_PORT=20030
MINIO_API_HOST_PORT=20040
MINIO_CONSOLE_HOST_PORT=20041

# Docker network — must be unique per concurrently-running workspace.
DOCKER_NETWORK_NAME=insur_iq_network

# APP ENV #
SERVER_NAME=

# BACKEND ENV #
DEBUG=True
APP_ENV=DEV
SECRET_KEY=mysecretkey
WEBHOOK_SECRET_KEY=mywebhooksecretkey
ALLOWED_HOSTS=*,
CSRF_TRUSTED_ORIGINS=http://localhost:8080,
HOST_NAME=http://localhost:8080

DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=insur_iq

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:20040
AWS_STORAGE_BUCKET_NAME=insur-iq
AWS_REGION=ap-south-1
AWS_S3_ADDRESSING_STYLE=path
AWS_SENDER_EMAIL=

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

GOOGLE_API_KEY=
POLICY_EXTRACT_CALLBACK_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CELERY_RESULT_BACKEND=django-db
CELERY_CACHE_BACKEND=django-cache
CELERY_BROKER_URL=redis://redis:6379/0
# policy_extract worker hardening (heavy MinerU/Gemini tasks). Concurrency is the
# peak-memory driver: each child may reach the 512MB --max-memory-per-child recycle
# threshold, so budget roughly CONCURRENCY x 512MB of host RAM. There is deliberately
# no container mem_limit — per-child recycling is the memory control, and an OOM kill
# at the container boundary would destroy an in-flight parse. Time limits scope to
# _run_parser alone (a soft raise -> clean FAILED; the hard limit kills a hung child).
# REDIS_MAXMEMORY caps the broker (noeviction, so tasks are never evicted). Redis
# defaults are wired in docker-compose.yml (dev); prod uses an external Redis.
# MinerU's limiter returns 503 the instant its semaphore empties, so it must stay
# strictly above total client concurrency (this + the commission-intake worker's 2)
# while POLICY_EXTRACT_PAGE_GATE is off. With the gate on, pages (not documents) are
# the throttle: size this to ceil(capacity / pages_per_doc / 0.78) — ~16 at 75
# pages and 6.25 pages/doc — so a child is always ready to acquire; children waiting
# on the gate are idle but cheap. 10 matches production and the Helm chart.
POLICY_EXTRACT_CONCURRENCY=10
POLICY_EXTRACT_SOFT_TIME_LIMIT=900
POLICY_EXTRACT_TIME_LIMIT=1080
# How long a request may sit in `processing` before the reconciler declares its
# worker dead. Must stay above POLICY_EXTRACT_TIME_LIMIT.
POLICY_EXTRACT_STALE_AFTER=1500
# Pre-MinerU precheck for policy PDFs: larger/longer documents (and encrypted or
# corrupt ones) fail locally instead of holding a MinerU GPU slot.
POLICY_EXTRACT_MAX_PAGES=50
POLICY_EXTRACT_MAX_BYTES=26214400
# Pages-in-flight admission control in front of MinerU (core/services/mineru_gate.py).
# Off = no waiting (counters for the metrics are still kept). MAX_PAGES_IN_FLIGHT is
# the fallback capacity — MinerU's sweep peak — overridden by the Redis key
# mineru:pages_capacity that the GPU fleet's capacity sync writes. GATE_MAX_WAIT is
# how long a document queues for capacity before its task re-queues itself.
# GATE_RESERVE_PAGES holds capacity back for the ungated MinerU callers.
# GATE_BACKFILL_SECONDS lets a smaller document jump a waiting head of line while
# the head has waited less than this (0 = strict FIFO); bounds starvation.
POLICY_EXTRACT_PAGE_GATE=false
POLICY_EXTRACT_MAX_PAGES_IN_FLIGHT=75
POLICY_EXTRACT_GATE_MAX_WAIT=240
POLICY_EXTRACT_GATE_RESERVE_PAGES=0
POLICY_EXTRACT_GATE_BACKFILL_SECONDS=30
# Split the parse into _run_ocr (queue policy_extract) -> _run_llm_map (queue
# policy_extract_llm). Start the celery_policy_extract_llm worker before flipping.
POLICY_EXTRACT_SPLIT_LLM=false
POLICY_EXTRACT_LLM_CONCURRENCY=4
# Ship capacity metrics (namespace InsurIQ/PolicyExtract) to CloudWatch every minute.
# Uses the host's instance role (needs cloudwatch:PutMetricData), never the AWS_*
# storage keys above. Region defaults to AWS_REGION.
POLICY_EXTRACT_METRICS_ENABLED=false
POLICY_EXTRACT_METRICS_REGION=
# In-app MinerU GPU fleet management, no Lambda (policy_extract/services/gpu_fleet.py
# and docs/policy-extract-autoscaling.md). Every CAPACITY_CYCLE_SECONDS the default
# worker syncs the gate's capacity to the live fleet, then optionally scales it.
# Capacity: MINERU_TARGET_GROUP_ARN set -> healthy ALB targets x PAGES_PER_GPU;
# ADAPTIVE_CAPACITY=true -> probe MinerU (also the fallback if the AWS call fails);
# neither -> static (MAX_PAGES_IN_FLIGHT or a hand-set mineru:pages_capacity).
# GPU_AUTOSCALE: off | watch (log "would scale") | on (set MINERU_ASG_NAME's desired
# count within GPU_MIN..GPU_MAX). IAM on the worker role: elasticloadbalancing:
# DescribeTargetHealth, autoscaling:DescribeAutoScalingGroups, SetDesiredCapacity.
POLICY_EXTRACT_CAPACITY_CYCLE_SECONDS=60
POLICY_EXTRACT_PAGES_PER_GPU=75
MINERU_TARGET_GROUP_ARN=
POLICY_EXTRACT_ADAPTIVE_CAPACITY=false
POLICY_EXTRACT_GPU_AUTOSCALE=off
MINERU_ASG_NAME=
POLICY_EXTRACT_GPU_MIN=1
POLICY_EXTRACT_GPU_MAX=4
POLICY_EXTRACT_SCALE_OUT_LAG_HOURS=1.0
POLICY_EXTRACT_SCALE_OUT_FAST_LAG_HOURS=3.0
POLICY_EXTRACT_SCALE_IN_LAG_HOURS=0.25
POLICY_EXTRACT_SCALE_OUT_SUSTAIN_SECONDS=180
POLICY_EXTRACT_SCALE_IN_SUSTAIN_SECONDS=1800
POLICY_EXTRACT_SCALE_COOLDOWN_SECONDS=600
# MinerU `backend` form field, sent by every caller. Flip to hybrid-http-client ONLY
# in lockstep with the server cutover to the standalone vLLM engine: http-client
# fails every request before that engine exists, and hybrid-auto-engine against the
# split workers starts an extra in-process engine that does not fit in VRAM.
MINERU_BACKEND=hybrid-auto-engine
CELERY_VISIBILITY_TIMEOUT=3600
REDIS_MAXMEMORY=512mb

LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# GEMINI_API_KEY feeds the cins public-API path; GOOGLE_API_KEY (above) feeds
# the policy_extract public-API path. Neither is used when Vertex (ADC) is on.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Stays gemini-2.5-flash-lite ($0.10/$0.40 per 1M tokens), which is the cheapest
# option and still resolves on the Vertex/ADC path this file defaults to.
# It is CLOSED to newly issued API keys, though — a fresh key 404s with "no longer
# available to new users". A deployment on the public Developer API must override
# this to gemini-3.1-flash-lite ($0.25/$1.50), the cheapest id such a key can
# serve; that is 2.5x the input and 3.75x the output cost, so do not set it on the
# Vertex path. gemini-3.5-flash-lite also works but costs more again ($0.30/$2.50).
POLICY_EXTRACT_GEMINI_MODEL=gemini-2.5-flash-lite
# Force Gemini structured output (response_json_schema) on the Stage-2 mapping call so
# flash-lite must return every schema field instead of intermittently dropping some
# (e.g. the OD/TP cover dates). No-redeploy rollback: set false to use the prompt-only
# config. A per-run ClientError (e.g. a schema-size 400) also degrades to prompt-only.
POLICY_EXTRACT_STAGE2_RESPONSE_SCHEMA=true
# Exclude worksheets whose Excel tab is hidden/veryHidden from commission
# extraction. Hidden sheets are still indexed and shown in the UI; they just
# never produce rules or appear in a pass prompt. Set to false to roll back.
CINS_SKIP_HIDDEN_SHEETS=true
# Codegen completeness gate: reconcile the rules Pass-3 codegen emitted against the
# rate-bearing rows the source grid contains; a whole-sheet/segment drop triggers a
# targeted retry, then flags the pass requires_review instead of shipping a silent
# empty. Set false to disable the gate (always pass) without a redeploy.
CINS_CODEGEN_GATE=true
# Gate tuning (rarely changed): fire the shortfall floor when emitted rules drop
# below expected*RATIO; ignore sheets/tables with fewer than MIN_EXPECTED rate rows
# (count noise dominates). Conservative defaults bias against false hard-fails.
CINS_CODEGEN_COVERAGE_FLOOR_RATIO=0.5
CINS_CODEGEN_COVERAGE_MIN_EXPECTED=4
# State and RTO must be non-empty on every exported deal. A rule with no state
# raises a HIGH issue, which blocks the CICS output-cache pin so the document is
# re-extracted rather than cached and exported blank; a rule whose product name
# resolves to no RTO bucket raises MEDIUM (non-blocking — it may simply be a
# non-motor line). Set false to disable the validator without a redeploy.
CINS_STATE_RTO_MANDATORY=true
# Cross-run regression guard: when a re-extraction (cache miss after a prompt /
# pipeline / model bump) drops a whole product/segment the last good run of the same
# document emitted, surface a loud warning and refuse to pin the regressed result.
# Set false to disable. RATIO = flag when total rules fall below this fraction of the
# prior good run; MIN_TOTAL = ignore docs with fewer baseline rules (count noise).
CINS_REGRESSION_GUARD=true
CINS_REGRESSION_GUARD_RATIO=0.75
CINS_REGRESSION_GUARD_MIN_TOTAL=20
# Chola make/model canonicalization + validation (one flag, both halves). Folds a
# rule's free-text vehicle_make / vehicle_model (and their _exclude twins) onto the
# spelling seeded in CarrierVehicleMMVMaster, and raises a MEDIUM (non-blocking)
# finding for values no vehicle matches. Set false to disable without a redeploy —
# note that turning it off changes make/model spellings, so it can trip
# CINS_REGRESSION_GUARD on an already-cached document.
CINS_CHOLA_MMV=true
# VehicleMake and VehicleModel must be non-empty on every exported Chola deal; a
# rule carrying neither an include nor an _exclude list raises a MEDIUM finding per
# product. MEDIUM, not HIGH, on purpose: a HIGH blocks the CICS output-cache pin,
# and most of the missing coverage is source-faithful (the Private Car grid has no
# MAKE/MODEL column). Set false to disable without a redeploy.
CINS_MAKE_MODEL_MANDATORY=true
# Vertex AI backend for Gemini (opt-in). Set to true to route Gemini calls
# through Vertex instead of the public Gemini Developer API. Vertex authenticates
# via ADC (no API key): place sa-key.json in the dir named by GCP_CREDENTIALS_DIR
# (mounted read-only at /secrets/gcp) and point GOOGLE_APPLICATION_CREDENTIALS at
# it. GOOGLE_CLOUD_PROJECT is required in Vertex mode — the client preflights it
# and fails fast if unset or the key file is missing. Use "global" (broad model
# availability, higher availability) or a regional endpoint like "us-central1".
# Do NOT use the bare "us"/"eu" multi-region values — gemini-2.5-flash-lite is not
# provisioned there for this project and they need the .rep. hostname the SDK
# doesn't build, so they 404. Set the flag empty to use the public Gemini
# Developer API with GEMINI_API_KEY instead.
# Vertex/ADC is the default here and the three vars below apply. To switch to the
# public Gemini Developer API instead, set this false and set BOTH keys above —
# GEMINI_API_KEY for cins, GOOGLE_API_KEY for policy_extract and pipelines.
# Setting only one leaves half the backend broken, and the policy_extract half
# fails silently on api_key=None rather than raising.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=rhobots-playzone
GOOGLE_CLOUD_LOCATION=global
GCP_CREDENTIALS_DIR=~/.gcp
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp/sa-key.json
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
EXCEL_AI_CLASSIFICATION_ENABLED=true

# WEB ENV #
NODE_ENV=development
NUXT_APP_BASE_URL=/
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:8080/auth/api/auth
NUXT_PUBLIC_APP_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_SCHEME=http
NUXT_PUBLIC_API_BASE_URL=localhost:8080/service-api
NUXT_PUBLIC_ENABLED_SOCIAL_PROVIDERS=

# AUTH ENV #
BASE_DOMAIN=localhost
BETTER_AUTH_SECRET=myauthsecret
BETTER_AUTH_URL=http://localhost:8080/auth
TRUSTED_ORIGINS=http://localhost:8080

DATABASE_STRING=postgres://postgres:postgres@postgres:5432/auth

REQUIRE_EMAIL_VERIFICATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

WEBHOOK_EP=http://backend:8000/api/auth/webhook/
