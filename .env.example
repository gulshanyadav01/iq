# ── Host port mappings ────────────────────────────────────────────────
# Override per workspace to avoid collisions when running multiple
# Conductor workspaces concurrently. Convention: pick a unique 2-digit
# prefix per workspace (e.g. 20xxx, 21xxx, 22xxx) and update every
# *_PORT / *_HOST_PORT below plus the browser-facing URL env vars to
# match. Container ports never change — only host-side bindings vary.
PROXY_PORT=8080
API_PORT=20000
APP_PORT=20001
AUTH_HOST_PORT=20010
POSTGRES_HOST_PORT=20020
REDIS_HOST_PORT=20030
MINIO_API_HOST_PORT=20040
MINIO_CONSOLE_HOST_PORT=20041

# Docker network — must be unique per concurrently-running workspace.
DOCKER_NETWORK_NAME=insure_iq_network

# APP ENV #
SERVER_NAME=

# BACKEND ENV #
DEBUG=True
APP_ENV=DEV
SECRET_KEY=mysecretkey
WEBHOOK_SECRET_KEY=mywebhooksecretkey
ALLOWED_HOSTS=*,
CSRF_TRUSTED_ORIGINS=http://localhost:8080,
HOST_NAME=http://localhost:8080

DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=insure_iq

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:20040
AWS_STORAGE_BUCKET_NAME=insure-iq
AWS_REGION=ap-south-1
AWS_S3_ADDRESSING_STYLE=path
AWS_SENDER_EMAIL=

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

GOOGLE_API_KEY=
POLICY_EXTRACT_CALLBACK_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CELERY_RESULT_BACKEND=django-db
CELERY_CACHE_BACKEND=django-cache
CELERY_BROKER_URL=redis://redis:6379/0

LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
EXCEL_AI_CLASSIFICATION_ENABLED=true

# WEB ENV #
NODE_ENV=development
NUXT_APP_BASE_URL=/
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:8080/auth/api/auth
NUXT_PUBLIC_APP_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_SCHEME=http
NUXT_PUBLIC_API_BASE_URL=localhost:8080/service-api
NUXT_PUBLIC_ENABLED_SOCIAL_PROVIDERS=google,github,microsoft

# AUTH ENV #
BASE_DOMAIN=localhost
BETTER_AUTH_SECRET=myauthsecret
BETTER_AUTH_URL=http://localhost:8080/auth
TRUSTED_ORIGINS=http://localhost:8080

DATABASE_STRING=postgres://postgres:postgres@postgres:5432/auth

REQUIRE_EMAIL_VERIFICATION=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

WEBHOOK_EP=http://backend:8000/api/auth/webhook/
