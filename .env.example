GOOGLE_API_KEY=
POLICY_EXTRACT_CALLBACK_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CELERY_RESULT_BACKEND=django-db
CELERY_CACHE_BACKEND=django-cache
CELERY_BROKER_URL=redis://redis:6379/0


# WEB ENV #
NODE_ENV=development
NUXT_APP_BASE_URL=/
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:8080/auth/api/auth
NUXT_PUBLIC_APP_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_SCHEME=http
NUXT_PUBLIC_API_BASE_URL=localhost:8080/service-api
NUXT_PUBLIC_ENABLED_SOCIAL_PROVIDERS=google,github,microsoft

# AUTH ENV #
PORT=10000
BASE_DOMAIN=localhost
BETTER_AUTH_SECRET=myauthsecret
