# SECRETS TEMPLATE — Copy this to values.secrets.yaml and fill in your actual secrets
# IMPORTANT: values.secrets.yaml is gitignored; never commit it to git
# This file shows which secrets need to be provided at helm install time

secrets:
  # Django backend
  secretKey: "django-secret-key-here"
  webhookSecretKey: "webhook-secret-here"

  # Database (postgres)
  dbPassword: "postgres-password"
  postgresSecretUsername: postgres
  postgresSecretPassword: postgres

  # Better Auth (external auth service)
  betterAuthSecret: "auth-secret-here"

  # AWS/MinIO S3 credentials
  awsAccessKeyId: "minio-access-key"
  awsSecretAccessKey: "minio-secret-key"
  minioSecretUsername: minio
  minioSecretPassword: miniosecret

  # OAuth providers (optional — leave empty if not using)
  googleClientId: ""
  googleClientSecret: ""
  githubClientId: ""
  githubClientSecret: ""
  microsoftClientId: ""
  microsoftClientSecret: ""

  # External APIs
  googleApiKey: ""
  minervaApiUrl: ""
  policyExtractCallbackUrl: ""
