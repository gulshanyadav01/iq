# ============================================================================
# AWS ECR Configuration
# ============================================================================
# This file provides configuration for deploying with ECR images
#
# Usage:
#   1. Copy this file: cp .env.ecr.example .env.ecr
#   2. Fill in AWS_ACCOUNT_ID and AWS_REGION below
#   3. Sourced automatically by scripts/build-and-push.sh
#   4. To deploy, override images.* in helm/insur-iq/values.*.yaml
# ============================================================================

# AWS Configuration
# Replace with your AWS account ID (12-digit number)
AWS_ACCOUNT_ID=123456789012

# AWS region where ECR repositories are located
AWS_REGION=ap-south-1

# ECR Registry URL (computed from account ID and region)
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# ============================================================================
# Image Names for Production Deployment
# ============================================================================
# These reference the ECR images instead of local builds
# Format: ${ECR_REGISTRY}/<repo>:<tag>

BACKEND_IMAGE_NAME=${ECR_REGISTRY}/insur-iq/backend:latest
WEB_IMAGE_NAME=${ECR_REGISTRY}/insur-iq/web:latest

# ============================================================================
# Docker Build Configuration
# ============================================================================
# Used by build-and-push.sh script

# Platforms to build for (multi-platform support)
# Options: linux/amd64, linux/arm64, linux/amd64,linux/arm64
DOCKER_PLATFORMS=linux/amd64,linux/arm64

# Default image tag
# Can be overridden: IMAGE_TAG=v1.0.0 ./scripts/build-and-push.sh
IMAGE_TAG=latest

# ============================================================================
# Version Pinning (Optional)
# ============================================================================
# Uncomment and set specific versions for production deployments
# This allows you to pin to specific image versions for stability

# BACKEND_IMAGE_NAME=${ECR_REGISTRY}/insur-iq/backend:v1.0.0
# WEB_IMAGE_NAME=${ECR_REGISTRY}/insur-iq/web:v1.0.0

# ============================================================================
# GitHub Actions Configuration (Optional)
# ============================================================================
# If using GitHub Actions for CI/CD, configure these in GitHub Secrets/Variables
# instead of in this file

# AWS_ROLE_TO_ASSUME - IAM role ARN for OIDC authentication
# Example: arn:aws:iam::123456789012:role/GitHubActionsECRPushRole
