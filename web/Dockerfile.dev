FROM node:24-alpine

WORKDIR /app

# Add dependencies
RUN apk update && apk upgrade --no-cache libc6-compat libcrypto3 libssl3

RUN apk add --no-cache dumb-init curl

# Install dependencies
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

# Copy full source for development
COPY . .

RUN pnpm install --filter web --frozen-lockfile

# Runtime environment variables will be passed via docker-compose
# Nuxt automatically reads NUXT_PUBLIC_* environment variables at startup

EXPOSE 3000

WORKDIR /app/web

# CMD ["tail", "-f", "/dev/null"]
CMD ["pnpm", "run", "dev"]
